root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,xaml}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.{ps1,psm1,psd1}]
# PowerShell 5.1 只有见到 BOM 才认 UTF-8，没有 BOM 会按 ANSI 读 → 中文全乱，故强制带 BOM
charset = utf-8-bom
indent_style = space
indent_size = 4

[*.{md,txt}]
trim_trailing_whitespace = false
