<Window x:Class="RecLite.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保存录音" Height="210" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#16161C"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="请输入文件名（不含扩展名）" Foreground="#9A9AB0" FontSize="12"/>
        <TextBox Grid.Row="1" x:Name="Input" Height="34" Margin="0,8,0,0"
                 Background="#2C2C38" Foreground="#E9E9F2" BorderBrush="#3A3A48"
                 Padding="8,6" VerticalContentAlignment="Center" FontSize="14"/>
        <TextBlock Grid.Row="2" x:Name="Hint" Text="" Foreground="#6E6E85" FontSize="11" Margin="0,6,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="90" Height="34" Margin="0,0,10,0" Click="Cancel_Click"
                    Background="#2C2C38" Foreground="#E9E9F2" BorderBrush="#3A3A48"/>
            <Button Content="确定" Width="90" Height="34" Click="Ok_Click" IsDefault="True"
                    Background="#5B8CFF" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
