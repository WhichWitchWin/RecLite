<Window x:Class="RecLite.FileListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录音文件" Height="480" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#16161C" ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#E9E9F2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#22222B"/>
            <Setter Property="Foreground" Value="#9A9AB0"/>
            <Setter Property="BorderBrush" Value="#33333F"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PathText" Foreground="#9A9AB0" FontSize="11"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,10"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

        <Border Grid.Row="1" Background="#1A1A22" BorderBrush="#33333F" BorderThickness="1" CornerRadius="8">
            <ListView x:Name="FileList" Background="Transparent" BorderThickness="0"
                      MouseDoubleClick="FileList_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="文件名" Width="330" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="大小" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="修改时间" Width="170" DisplayMemberBinding="{Binding ModifiedText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="刷新" Width="80" Height="32" Margin="0,0,8,0" Click="Refresh_Click"
                    Background="#2C2C38" Foreground="#E9E9F2" BorderBrush="#3A3A48"/>
            <Button Content="打开文件夹" Width="110" Height="32" Margin="0,0,8,0" Click="OpenFolder_Click"
                    Background="#2C2C38" Foreground="#E9E9F2" BorderBrush="#3A3A48"/>
            <Button Content="▶ 播放选中" Width="110" Height="32" Margin="0,0,8,0" Click="Play_Click"
                    Background="#5B8CFF" Foreground="White" BorderThickness="0" IsDefault="True"/>
            <Button Content="关闭" Width="80" Height="32" Click="Close_Click"
                    Background="#2C2C38" Foreground="#E9E9F2" BorderBrush="#3A3A48"/>
        </StackPanel>
    </Grid>
</Window>
