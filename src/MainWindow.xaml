<Window x:Class="RecLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RecLite"
        Title="RecLite 轻录音" Height="700" Width="1000"
        Icon="app.ico"
        MinHeight="600" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        PreviewMouseDown="Window_PreviewMouseDown"
        AllowDrop="True"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        Background="#16161C">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#22222B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#33333F"/>
        <SolidColorBrush x:Key="TextMain" Color="#E9E9F2"/>
        <SolidColorBrush x:Key="TextDim" Color="#9A9AB0"/>
        <SolidColorBrush x:Key="Accent" Color="#5B8CFF"/>
        <SolidColorBrush x:Key="Warn" Color="#FFC13D"/>
        <SolidColorBrush x:Key="Danger" Color="#FF5B6E"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E9E9F2"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ib" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="#E9E9F2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="#3A3A48"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="#4A6FD4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#2C2C38"/>
            <Setter Property="Foreground" Value="#E9E9F2"/>
            <Setter Property="BorderBrush" Value="#3A3A48"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="9,0,4,0" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="#E9E9F2"/>
                                    <Path Grid.Column="1" Data="M 0 0 L 4.5 4.5 L 9 0"
                                          Stroke="#9A9AB0" StrokeThickness="1.6"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#2C2C38" BorderBrush="#3A3A48" BorderThickness="1"
                                        CornerRadius="6" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="280">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5B8CFF"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5B8CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#2C2C38"/>
            <Setter Property="Foreground" Value="#E9E9F2"/>
            <Setter Property="BorderBrush" Value="#3A3A48"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E9E9F2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 第一行：设备 ===== -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.7*"/>
                </Grid.ColumnDefinitions>

                <!-- 录音中整块会被调暗（代码里设 Opacity）：暗色主题的 ComboBox 模板没有禁用态样式，
                     只靠 IsEnabled=false 视觉上看不出变化，所以连标签一起调暗才明显 -->
                <StackPanel x:Name="CapturePanel" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="录制通道" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CaptureCombo" SelectionChanged="CaptureCombo_SelectionChanged"/>
                    <TextBlock x:Name="CaptureInfo" Foreground="#6E6E85" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="试听播放通道" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="PlaybackCombo" SelectionChanged="PlaybackCombo_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="预录缓存" Style="{StaticResource Label}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 双击下拉框 → 变成输入框；回车 / 点别处生效，Esc 放弃。
                             不用 IsEditable：暗色主题下它的内部文本框颜色不受样式控制，会看不见字。 -->
                        <Grid Grid.Column="0">
                            <!-- ToolTip 由代码设置：上限要引用 PrerollBuffer.MaxSeconds，不能写死数字 -->
                            <ComboBox x:Name="PrerollCombo"
                                      SelectionChanged="PrerollCombo_SelectionChanged"
                                      PreviewMouseLeftButtonDown="PrerollCombo_PreviewMouseLeftButtonDown"/>

                            <!-- 不设 Height：默认 Stretch，和 ComboBox 一样高，进出编辑时整行不会跳 -->
                            <TextBox x:Name="PrerollEdit" Visibility="Collapsed"
                                     VerticalContentAlignment="Center"
                                     Background="#1B1B24" Foreground="#E9E9F2"
                                     BorderBrush="#3A3A48" CaretBrush="#E9E9F2"
                                     PreviewKeyDown="PrerollEdit_PreviewKeyDown"
                                     LostKeyboardFocus="PrerollEdit_LostKeyboardFocus"/>
                        </Grid>

                        <Button x:Name="ResetPrerollBtn" Grid.Column="1" Margin="6,0,0,0"
                                Click="ResetPreroll_Click" Background="#2C2C38" BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="清空已经缓存的内容，从现在重新开始预录">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="清空缓存" Foreground="#E9E9F2" FontSize="11" Margin="6,0"/>
                        </Button>

                        <Button x:Name="SavePrerollBtn" Grid.Column="2" Margin="6,0,0,0"
                                Click="SavePreroll_Click" Background="#2C2C38" BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="把当前预录缓存里的音频另存为 WAV 文件">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="存预录" Foreground="#E9E9F2" FontSize="11" Margin="9,0"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 第二行：保存参数 ===== -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="0.95*"/>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="1.0*"/>
                    <ColumnDefinition Width="1.8*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="保存格式" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="FormatCombo" SelectionChanged="FormatCombo_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="采样率" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="RateCombo" SelectionChanged="RateCombo_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="文件名方式" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="NameModeCombo" SelectionChanged="NameModeCombo_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Text="文件名前缀" Style="{StaticResource Label}"/>
                    <TextBox x:Name="PrefixBox" TextChanged="PrefixBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,12,0">
                    <TextBlock Text="保存目录" Style="{StaticResource Label}"/>
                    <TextBox x:Name="DirBox" IsReadOnly="True" FontSize="11"
                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="FilesBtn" Content="打开文件夹" Width="86" Height="30"
                            Click="OpenDir_Click" Background="#2C2C38" Foreground="#E9E9F2" BorderBrush="#3A3A48"
                            ToolTip="在资源管理器中打开录音目录"/>
                    <Button x:Name="ChangeDirBtn" Content="更改文件夹" Width="86" Height="30" Margin="8,0,0,0"
                            Click="ChangeDir_Click" Background="#2C2C38" Foreground="#E9E9F2" BorderBrush="#3A3A48"
                            ToolTip="选择一个新的目录用来保存录音"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 第三行：音量 + 选项 ===== -->
        <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 计时与预录提示（原来是右下角），精度到毫秒 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <!-- 颜色由代码按状态设置：白=空闲 / 绿=预录缓存中 / 黄=录制中（见 WavePalette） -->
                    <TextBlock x:Name="TimerText" Text="00:00:000" FontSize="22" FontFamily="Consolas"
                               Foreground="#D8D8E8"/>
                    <TextBlock x:Name="PrerollText" Text="" Foreground="#6E6E85" FontSize="11"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="录制音量" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <local:VolumeGauge x:Name="RecordVolGauge" MaxPercent="300"
                                       ValueChanged="RecordVol_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="试听音量" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <local:VolumeGauge x:Name="PlayVolGauge" MaxPercent="200"
                                       ValueChanged="PlayVol_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <CheckBox x:Name="IncludePrerollCheck" Content="保存时包含预录片段"
                              Margin="0,0,0,6"
                              Checked="IncludePreroll_Changed" Unchecked="IncludePreroll_Changed"
                              ToolTip="取消勾选：即使开了预录，保存时也不把点录音之前那段加进去"/>
                    <CheckBox x:Name="IdleWaveCheck" Content="待机也显示波形"
                              Checked="IdleWave_Changed" Unchecked="IdleWave_Changed"
                              ToolTip="取消勾选：不录音时波形区保持静止"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 第四行：波形 + 输入/输出电平 ===== -->
        <Border Grid.Row="3" Background="#0F0F14" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>

                    <!-- dB 刻度条：独立一条，双击这里复位缩放（不会碰到播放位置） -->
                    <local:DbScaleControl x:Name="DbScale" Grid.Row="0" Grid.Column="0"/>
                    <local:WaveformControl x:Name="Waveform" Grid.Row="0" Grid.Column="1"/>

                    <!-- 时间轴：常开，贴在波形下方（双击这里也复位缩放） -->
                    <local:TimelineControl x:Name="Timeline" Grid.Row="1" Grid.Column="1" Margin="0,2,0,0"/>
                </Grid>

                <!-- 刻度切换（原来在音量行最右，挪到波形左下角） -->
                <Button x:Name="ScaleBtn" Grid.Column="0" Content="刻度：线性"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="6,0,0,30" Width="92" Height="22" FontSize="11"
                        Click="ScaleBtn_Click"
                        Background="#2C2C38" Foreground="#E9E9F2" BorderBrush="#3A3A48"
                        ToolTip="点击切换波形振幅显示方式：线性 ⇄ 对数(dB)"/>

                <!-- 右侧：输入 / 输出两条纵向电平表，各配独立削波灯 -->
                <Grid Grid.Column="1" Margin="8,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <local:ClipIndicator x:Name="InClipLight" Grid.Row="0" Grid.Column="1"
                                         Width="22" Height="6" Margin="0,0,0,2"/>
                    <local:ClipIndicator x:Name="OutClipLight" Grid.Row="0" Grid.Column="2"
                                         Width="22" Height="6" Margin="6,0,0,2"/>

                    <local:LevelMeter x:Name="InMeter" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                      Width="52" HorizontalAlignment="Left"
                                      IsVertical="True" ShowScale="True"/>
                    <local:LevelMeter x:Name="OutMeter" Grid.Row="1" Grid.Column="2"
                                      Width="22" Margin="6,0,0,0" IsVertical="True"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== 第五行：控制条 ===== -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="RecordBtn" Grid.Column="0" Width="132" Height="46" Click="RecordBtn_Click"
                    Background="{StaticResource Danger}" Foreground="White" BorderThickness="0"
                    FontSize="16" FontWeight="SemiBold" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="RecordBtnText" Text="● 开始录音" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
            </Button>

            <Button x:Name="PauseBtn" Grid.Column="1" Width="104" Height="46" Margin="10,0,0,0"
                    Click="PauseBtn_Click" IsEnabled="False"
                    Background="#2C2C38" Foreground="#E9E9F2" BorderThickness="0"
                    FontSize="14" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="PauseBtnText" Text="⏸ 暂停" Foreground="#E9E9F2" FontSize="14"/>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button x:Name="PlayBtn" Width="96" Height="46"
                        Click="PlayBtn_Click" IsEnabled="False"
                        Background="#2C2C38" Foreground="#E9E9F2" BorderThickness="0"
                        FontSize="14" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="PlayBtnText" Text="▶ 试听" Foreground="#E9E9F2" FontSize="14"/>
                </Button>

                <!-- 打开任意音频文件试听（不用先录一条） -->
                <Button x:Name="OpenFileBtn" Width="96" Height="46" Margin="8,0,0,0"
                        Click="OpenFile_Click"
                        Background="#2C2C38" Foreground="#E9E9F2" BorderThickness="0"
                        FontSize="14" Cursor="Hand"
                        ToolTip="打开任意音频文件试听（WAV / MP3 / AIFF / FLAC / M4A / AAC / WMA）">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="📂 打开文件" Foreground="#E9E9F2" FontSize="14"/>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="18,0">
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="14"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>
        </Grid>

        <!-- 拖放提示遮罩：文件拖进窗口时盖住整个界面 -->
        <Border x:Name="DropHint" Grid.RowSpan="5" Visibility="Collapsed"
                Background="#B0000000" IsHitTestVisible="False">
            <Border Background="#22FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="2"
                    CornerRadius="16" Margin="26">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⬇" FontSize="52" Foreground="#CCFFFFFF"
                               HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="松开鼠标即可播放" FontSize="24" FontWeight="SemiBold"
                               Foreground="#FFFFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="WAV / MP3 / AIFF / FLAC / M4A / AAC / WMA"
                               FontSize="13" Foreground="#99FFFFFF"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
